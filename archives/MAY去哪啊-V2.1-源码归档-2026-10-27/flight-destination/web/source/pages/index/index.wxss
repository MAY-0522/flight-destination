page { background: #f5f8f7; color: #172020; font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif; }
view, text { box-sizing: border-box; }
.page { min-height: 100vh; padding-bottom: 60rpx; background: #f5f8f7; }
.top-bar { display:flex; align-items:center; justify-content:space-between; padding: 42rpx 36rpx 12rpx; }
.top-controls { display:flex; align-items:center; gap:8rpx; flex-shrink:0; }
.currency-switch { min-width:112rpx; padding:13rpx 17rpx; display:flex; align-items:center; justify-content:center; gap:9rpx; border-radius:999rpx; color:#117f80; background:#fff; box-shadow:0 2rpx 8rpx rgba(20,55,55,.08); font-size:21rpx; line-height:1.2; font-weight:700; white-space:nowrap; }
.currency-icon { min-width:24rpx; color:#159fa0; text-align:center; font-size:23rpx; line-height:1.2; font-weight:800; flex-shrink:0; }
.currency-arrow { width:0; height:0; margin-left:2rpx; border-left:7rpx solid transparent; border-right:7rpx solid transparent; border-top:9rpx solid #159fa0; transform:translateY(-2rpx); flex-shrink:0; }
.language-switch { display:flex; align-items:center; gap:4rpx; padding:5rpx; border-radius:999rpx; background:#e9eeee; }
.language-option { min-width:84rpx; padding:11rpx 16rpx; border-radius:999rpx; color:#7d8989; text-align:center; font-size:20rpx; line-height:1.2; font-weight:600; }
.language-option-active { color:#117f80; background:#fff; box-shadow:0 2rpx 8rpx rgba(20,55,55,.1); }
.brand { display: flex; align-items: center; min-height: 52rpx; }
.brand-icon { width: 72rpx; height: 72rpx; flex-shrink: 0; margin-right: 14rpx; overflow: hidden; border-radius: 50%; }

.brand-name { color: #182222; font-size: 31rpx; line-height: 52rpx; font-weight: 750; }
.hero { padding: 42rpx 36rpx 32rpx; }
.hero-kicker { display: block; color: #159fa0; font-size: 20rpx; letter-spacing: 2rpx; font-weight: 700; }
.hero-title { display: block; margin-top: 14rpx; color: #172020; font-size: 49rpx; line-height: 1.18; font-weight: 800; letter-spacing: -1.5rpx; }
.hero-description { display: block; margin-top: 14rpx; color: #788585; font-size: 25rpx; line-height: 1.55; }
.search-card { margin: 0 24rpx; padding: 32rpx 28rpx 30rpx; border-radius: 28rpx; background: #fff; box-shadow: 0 12rpx 40rpx rgba(31,57,57,.07); }
.field { margin-bottom: 26rpx; }
.trip-type-field { margin-bottom: 28rpx; }
.trip-type-switch { display: flex; gap: 10rpx; padding: 8rpx; border-radius: 18rpx; background: #f1f5f4; }
.trip-type-option { display: flex; flex: 1; align-items: center; justify-content: center; min-height: 68rpx; border-radius: 13rpx; color: #718080; font-size: 24rpx; font-weight: 600; }
.trip-type-option-active { color: #117f80; background: #fff; box-shadow: 0 3rpx 12rpx rgba(31,57,57,.08); }
.destination-field { margin-bottom: 20rpx; }
.field-title { display: block; margin-bottom: 12rpx; color: #253131; font-size: 26rpx; line-height: 36rpx; font-weight: 700; }
.route-field { min-height: 112rpx; padding: 20rpx 18rpx; border: 1rpx solid #e4ebea; border-radius: 20rpx; background: #fff; display: flex; align-items: center; }
.airport-icon { width: 58rpx; height: 58rpx; margin-right: 18rpx; border-radius: 18rpx; background: #edf7f6; color: #159fa0; display: flex; align-items: center; justify-content: center; font-size: 22rpx; font-weight: 700; }
.destination-icon { background: #e2f4f3; }
.route-copy { display: flex; flex: 1; flex-direction: column; gap: 6rpx; }
.route-city { color: #182222; font-size: 29rpx; font-weight: 700; }
.route-detail { color: #9ca6a6; font-size: 19rpx; }
.picker-arrow { padding: 0 6rpx; color: #9ca6a6; font-size: 32rpx; }
.route-divider { display: flex; align-items: center; gap: 12rpx; margin: -8rpx 4rpx 18rpx; color: #aeb6b6; font-size: 18rpx; }
.route-divider view { height: 1rpx; flex: 1; background: #e7ebeb; }
.route-availability { margin: 2rpx 0 22rpx; color: #788585; font-size: 20rpx; text-align: center; }
.primary-button { position: relative; width: 400rpx; height: 92rpx; margin: 0 auto; padding: 0; line-height: 92rpx; text-align: center; border: 0; border-radius: 20rpx; color: #fff; background: #159fa0; box-shadow: 0 10rpx 22rpx rgba(21,159,160,.16); font-size: 28rpx; font-weight: 700; }
.primary-button::after { border: 0; }
.primary-button .button-label { display: block; }
.primary-button .button-arrow { position: absolute; top: 50%; right: 38rpx; margin: 0; font-size: 30rpx; line-height: 1; transform: translateY(-50%); }
.section-title { margin: 38rpx 36rpx 16rpx; color: #253131; font-size: 26rpx; font-weight: 700; }
.feature-card { margin: 0 24rpx; padding: 12rpx 26rpx; border-radius: 26rpx; background: #fff; box-shadow: 0 12rpx 40rpx rgba(31,57,57,.05); }
.feature-row { display: flex; align-items: center; gap: 18rpx; padding: 20rpx 0; }
.feature-row + .feature-row { border-top: 1rpx solid #f0f3f3; }
.feature-icon { width: 54rpx; height: 54rpx; flex: none; border-radius: 17rpx; display: flex; align-items: center; justify-content: center; color: #159fa0; background: #edf7f6; font-size: 26rpx; font-weight: 700; }
.feature-row > view:last-child { display: flex; flex-direction: column; gap: 6rpx; }
.feature-name { color: #273333; font-size: 23rpx; font-weight: 700; }
.feature-copy { color: #9ca6a6; font-size: 19rpx; }
.sample-merge-note { margin: 8rpx 36rpx 0; color: #788585; font-size: 18rpx; line-height: 1.45; }
.footer { padding: 20rpx 36rpx 8rpx; color: #9ca6a6; text-align: center; font-size: 18rpx; line-height: 1.6; }

.fixed-tag { padding: 6rpx 12rpx; border-radius: 999rpx; color: #159fa0; background: #edf7f6; font-size: 18rpx; }
.pool-heading { display: flex; align-items: baseline; justify-content: space-between; margin: 38rpx 36rpx 16rpx; color: #253131; font-size: 26rpx; font-weight: 700; }
.pool-heading text:last-child { color: #9ca6a6; font-size: 19rpx; font-weight: 400; }
.destination-grid { display: flex; flex-direction: row; flex-wrap: wrap; justify-content: space-between; margin: 0 24rpx; }
.destination-tile { display: flex; flex: 0 0 48%; width: 48%; min-height: 142rpx; margin-bottom: 14rpx; flex-direction: column; justify-content: center; padding: 18rpx 20rpx; border: 1rpx solid #e4ebea; border-radius: 20rpx; background: #fff; box-sizing: border-box; }
.destination-tile-active { border: 2rpx solid #159fa0; background: #f0f9f8; box-shadow: 0 6rpx 18rpx rgba(21,159,160,.10); }
.destination-tile-pressed { opacity: .82; transform: scale(.985); }
.destination-tile-top { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; }
.destination-tile-name { color: #182222; font-size: 25rpx; font-weight: 700; }
.destination-tile-code { color: #159fa0; font-size: 19rpx; font-weight: 700; }
.destination-tile-country { margin-top: 6rpx; color: #9ca6a6; font-size: 18rpx; }
.destination-tile-status { margin-top: 10rpx; color: #9ca6a6; font-size: 17rpx; }
.destination-tile-status.destination-ready { color: #159fa0; }

.public-fares-section { margin-top: 30rpx; }
.public-fares-heading { margin: 0 36rpx 16rpx; color: #253131; font-size: 26rpx; line-height: 36rpx; font-weight: 700; }
.public-fares-heading text { margin-left: 8rpx; color: #9ca6a6; font-size: 19rpx; line-height: 1.4; font-weight: 400; }
.public-fares-card { margin: 0 24rpx; padding: 26rpx 28rpx; border-radius: 28rpx; background: #fff; box-shadow: 0 12rpx 40rpx rgba(31,57,57,.07); }
.public-fares-note, .public-fares-empty { color: #788585; font-size: 21rpx; line-height: 1.55; }
.public-fares-status { margin-bottom: 9rpx; color: #117f80; font-size: 20rpx; line-height: 1.5; font-weight: 650; }
.public-fares-empty { padding: 18rpx 0 4rpx; }
.public-fare-row { margin-top: 22rpx; padding-top: 20rpx; border-top: 1rpx solid #e4ebea; }
.public-fare-top { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.public-fare-date { color: #253131; font-size: 22rpx; font-weight: 650; }
.public-fare-price { color: #117f80; font-size: 24rpx; font-weight: 750; white-space: nowrap; }
.public-fare-meta { margin-top: 8rpx; color: #788585; font-size: 19rpx; line-height: 1.5; }
.public-fare-link { display: inline-block; margin-top: 10rpx; color: #117f80; font-size: 19rpx; }











.pool-note { margin: -6rpx 36rpx 16rpx; color: #9ca6a6; font-size: 18rpx; line-height: 1.5; }


.destination-picker-mask { position: fixed; z-index: 1000; inset: 0; display: flex; align-items: flex-end; background: rgba(16, 30, 30, .42); }
.destination-picker-panel { display: flex; flex-direction: column; width: 100%; height: 86vh; max-height: 90vh; padding-bottom: env(safe-area-inset-bottom); overflow: hidden; border-radius: 30rpx 30rpx 0 0; background: #fff; box-sizing: border-box; }
.destination-picker-header { display: flex; align-items: center; justify-content: space-between; height: 100rpx; flex: none; padding: 0 34rpx; border-bottom: 1rpx solid #f0f3f3; }
.destination-picker-cancel, .destination-picker-confirm { min-width: 82rpx; color: #728080; font-size: 27rpx; }
.destination-picker-confirm { color: #159fa0; text-align: right; font-weight: 700; }
.destination-picker-title { color: #243030; font-size: 29rpx; font-weight: 700; }
.destination-search-box { display: flex; align-items: center; height: 74rpx; flex: none; margin: 18rpx 28rpx 10rpx; padding: 0 22rpx; border-radius: 16rpx; background: #f3f6f6; }
.destination-search-icon { margin-right: 12rpx; color: #899595; font-size: 34rpx; line-height: 1; }
.destination-search-input { flex: 1; color: #253131; font-size: 24rpx; }
.destination-search-clear { padding: 4rpx 8rpx; color: #9ca6a6; font-size: 32rpx; }
.destination-picker-list { flex: 1; height: 0; padding: 0 28rpx 18rpx; box-sizing: border-box; }
.destination-letter { padding: 20rpx 8rpx 10rpx; color: #159fa0; font-size: 21rpx; font-weight: 700; }
.destination-option { display: flex; align-items: center; justify-content: space-between; min-height: 86rpx; padding: 0 12rpx; border-bottom: 1rpx solid #f1f3f3; }
.destination-option-selected { background: #f5fbfa; }
.destination-option-copy { display: flex; align-items: baseline; gap: 12rpx; }
.destination-option-name { color: #243030; font-size: 27rpx; }
.destination-option-code { color: #a4adad; font-size: 18rpx; letter-spacing: .5rpx; }
.destination-option-right { display: flex; align-items: center; gap: 18rpx; }
.destination-option-country { color: #9ca6a6; font-size: 21rpx; }
.destination-option-check { color: #159fa0; font-size: 28rpx; font-weight: 700; }
.destination-empty { padding: 100rpx 0; color: #9ca6a6; text-align: center; font-size: 24rpx; }
