<view class="page">
  <view class="top-bar"><view class="brand"><view class="brand-icon"><image class="brand-logo" style="width:72rpx;height:72rpx;display:block;" src="../../assets/may-logo.png" mode="aspectFill" /></view><text class="brand-name">MAY去哪啊</text></view><view class="top-controls"><view class="currency-switch" bindtap="selectCurrency"><text class="currency-icon">{{currencySymbol}}</text><text>{{displayCurrency}}</text><view class="currency-arrow"></view></view><view class="language-switch"><view class="language-option {{language === 'en' ? 'language-option-active' : ''}}" data-language="en" bindtap="selectLanguage">{{isEnglish ? 'English' : '英语'}}</view><view class="language-option {{language === 'zh' ? 'language-option-active' : ''}}" data-language="zh" bindtap="selectLanguage">{{isEnglish ? 'Chinese' : '简体中文'}}</view></view></view></view>
  <view class="hero"><view class="eyebrow">{{isEnglish ? 'Flight Fare Analysis' : '航线价格分析'}}</view><view class="route-title">{{routeTitle}}</view><view class="route-subtitle">{{routeSubtitle}}</view><view class="status-pill">{{tripTypeLabel}} · {{hasData ? (isEnglish ? 'Sample analysis · ' + sample.referenceLevel : '样本分析 · ' + sample.referenceLevel) : (isEnglish ? 'No samples available' : '暂无可用样本')}}</view></view>
  <view class="unavailable-card" wx:if="{{!hasData}}"><view class="unavailable-icon">i</view><view class="unavailable-title">{{isEnglish ? tripTypeLabel + ' fare samples are not available yet' : tripTypeLabel + '价格样本尚未收录'}}</view><view class="unavailable-copy">{{isEnglish ? 'No verified public fare samples are available for ' + routeTitle + '. We will not substitute fares from another trip type.' : routeTitle + ' 的' + tripTypeLabel + '分析目前没有可用的真实公开标价。我们不会用其他行程类型的价格生成参考。'}}</view><view class="unavailable-copy">{{isEnglish ? 'Once reliable samples are collected, this page will show the matching fare analysis and sample coverage.' : '收录可靠样本后，页面会展示对应行程类型的人民币价格分析，并注明样本范围。'}}</view></view>
  <block wx:else>
    <view class="notice-card"><view class="notice-title">{{isEnglish ? 'About these samples' : '先看样本说明'}}</view><view class="notice-copy">{{isEnglish ? 'Past-date fares are limited to the last year. Public pages with a dated order/payment statement from the last year may be labeled as order records; these statements are not independently authenticated.' : '过去日期报价仅保留近一年。公开网页出现近一年内带日期的下单或付款描述时，可归为网页订单记录；这些页面内容未经独立核验。'}}</view></view>
    <view class="section-heading">{{isEnglish ? 'Fare Distribution' : '价格分布'}} <text>{{displayCurrency}} · {{isEnglish ? (tripType === 'round_trip' ? 'round-trip total' : 'one-way fare') : (tripType === 'round_trip' ? '往返总价' : '单程标价')}} {{isEnglish ? 'converted' : '换算'}}</text></view>
    <view class="card price-card"><view class="median-label">{{isEnglish ? (tripType === 'round_trip' ? 'Median Round-trip Fare' : 'Median One-way Fare') : (tripType === 'round_trip' ? '样本往返总价中位数' : '样本单程标价中位数')}}</view><view class="median-price">{{currencySymbol}} {{price.median}}</view><view class="range-line">{{isEnglish ? 'Low' : '最低'}} {{currencySymbol}} {{price.minimum}} <text>—</text> {{isEnglish ? 'High' : '最高'}} {{currencySymbol}} {{price.maximum}}</view><view class="quantile-grid"><view class="quantile-item"><text>P10</text><text>{{currencySymbol}} {{price.p10}}</text></view><view class="quantile-item"><text>P25</text><text>{{currencySymbol}} {{price.p25}}</text></view><view class="quantile-item featured"><text>{{isEnglish ? 'Median' : '中位数'}}</text><text>{{currencySymbol}} {{price.median}}</text></view><view class="quantile-item"><text>P75</text><text>{{currencySymbol}} {{price.p75}}</text></view><view class="quantile-item"><text>P90</text><text>{{currencySymbol}} {{price.p90}}</text></view></view><view class="hint">{{isEnglish ? 'Listed fares come from different dates and sources. Taxes and baggage may vary.' : '分位数来自不同日期和来源的展示标价，税费与行李口径可能不同。'}}</view></view>
    <view wx:if="{{tripType === 'round_trip'}}"><view class="section-heading">{{isEnglish ? 'Round-trip Duration' : '往返行程时长'}} <text>{{isEnglish ? 'Outbound to return dates' : '按去程与返程日期计算'}}</text></view><view class="card duration-card"><view class="median-label">{{isEnglish ? 'Median nights' : '样本行程晚数中位数'}}</view><view class="median-price duration-median">{{tripDurationMedian}}</view><view class="lead-row" wx:for="{{tripDurationRows}}" wx:key="range"><view class="lead-top"><text class="lead-range">{{item.range}}</text><text wx:if="{{item.count}}">{{currencySymbol}} {{item.average}} <text class="lead-count">· {{item.count}} {{isEnglish ? 'trips' : '个行程'}}</text></text><text wx:else class="lead-count">{{isEnglish ? 'No samples' : '暂无样本'}}</text></view><view class="bar-track lead-track"><view class="bar-fill lead-fill" style="width: {{item.width}}"></view></view></view><view class="hint">{{isEnglish ? 'Fares by stay length depend on dates and sample coverage; shown for reference only.' : '不同停留时长的价格受日期和样本范围影响，仅作描述性参考。'}}</view></view></view>
    <view class="section-heading">{{isEnglish ? (tripType === 'round_trip' ? 'Outbound Departure Weekday' : 'Departure Weekday') : (tripType === 'round_trip' ? '去程出发星期' : '出发星期')}} <text>{{isEnglish ? 'Average fare by day (' + displayCurrency + ')' : '各星期平均标价（' + displayCurrency + '）'}}</text></view>
    <view class="card weekday-chart-card"><view class="chart-caption"><view class="chart-legend-dot"></view><text>{{isEnglish ? 'Average fare' : '平均标价'}}</text><view class="chart-legend-dot low"></view><text>{{isEnglish ? 'Lower' : '较低日'}}</text><view class="chart-legend-dot high"></view><text>{{isEnglish ? 'Higher' : '较高日'}}</text></view><view class="chart-stage"><canvas canvas-id="weekdayChart" id="weekdayChart" class="chart-canvas" width="300" height="160" style="width: 610rpx; height: 320rpx;" bindtap="onChartTap" bindtouchstart="onChartTap" bindtouchmove="onChartTouchMove"></canvas><view wx:if="{{selectedPoint}}" class="chart-tooltip" style="left: {{selectedPoint.left}}rpx; top: {{selectedPoint.top}}rpx;"><text>{{selectedPoint.day}}</text><text>{{currencySymbol}} {{selectedPoint.average}}</text></view></view><view class="weekday-days"><view class="weekday-day {{item.isLowest ? 'low' : ''}} {{item.isHighest ? 'high' : ''}}" wx:for="{{chartPoints}}" wx:key="day">{{item.day}}</view></view><view class="weekday-extremes"><view class="weekday-extreme low"><text>{{isEnglish ? 'Lowest sample average' : '样本均价较低'}}</text><text>{{weekdaySummary.lowestDay}} · {{currencySymbol}} {{weekdaySummary.lowestAverage}}</text></view><view class="weekday-extreme high"><text>{{isEnglish ? 'Highest sample average' : '样本均价较高'}}</text><text>{{weekdaySummary.highestDay}} · {{currencySymbol}} {{weekdaySummary.highestAverage}}</text></view></view><view class="insight-note">{{isEnglish ? 'Each weekday has few departure date samples. This chart describes a public fare snapshot and does not predict future prices.' : '每个星期几只有少量出发日期样本；折线是一次公开标价快照的描述，不代表稳定规律或未来票价。'}}</view></view>
    <view class="section-heading">{{isEnglish ? (tripType === 'round_trip' ? 'Outbound Weekend vs. Weekday' : 'Weekend vs. Weekday') : (tripType === 'round_trip' ? '去程周末与工作日' : '出发周末与工作日')}}</view><view class="card compare-card"><view class="compare-headline">{{weekend.label}}</view><view class="compare-values"><view><text>{{isEnglish ? 'Weekday average' : '工作日均价'}}</text><text class="compare-price">{{currencySymbol}} {{weekend.weekdayAverage}}</text></view><view><text>{{isEnglish ? 'Weekend average' : '周末均价'}}</text><text class="compare-price">{{currencySymbol}} {{weekend.weekendAverage}}</text></view></view><view class="hint">{{weekendNote}}</view></view>
    <view class="section-heading">{{isEnglish ? (tripType === 'round_trip' ? 'Days Before Outbound Fare Comparison' : 'Days Before Departure Fare Comparison') : (tripType === 'round_trip' ? '距去程出发日的价格对比' : '距出发日的价格对比')}} <text>{{isEnglish ? 'Exploratory' : '探索性结果'}}</text></view><view class="card"><view class="lead-row" wx:for="{{leadTimeRows}}" wx:key="range"><view class="lead-top"><text class="lead-range {{item.isLowest ? 'lead-range-highlight' : ''}}">{{item.range}}</text><text wx:if="{{item.count}}">{{currencySymbol}} {{item.average}} <text class="lead-count">· {{item.count}} {{isEnglish ? 'dates' : '个日期'}}</text></text><text wx:else class="lead-count">{{isEnglish ? 'No samples' : '暂无样本'}}</text></view><view class="bar-track lead-track"><view class="bar-fill lead-fill" style="width: {{item.width}}"></view></view></view><view class="insight-note lead-insight-note"><block wx:if="{{hasLeadWindow}}"><text>{{isEnglish ? 'In this sample, ' : '本次样本中，'}}</text><text class="lead-highlight">{{leadWindow}}</text><text>{{isEnglish ? ' has a relatively lower average. This is not a best time to book.' : '均价相对较低；不同出发日横截面对比，不能称为最佳购票窗口。'}}</text></block><text wx:else>{{isEnglish ? 'There is not enough data to compare booking lead times.' : '当前样本不足，暂时无法比较提前购买时间。'}}</text></view></view>
    <view class="section-heading">{{isEnglish ? 'Holiday Effects' : '节假日影响'}}</view><view class="card holiday-card"><view class="holiday-icon">i</view><view>{{isEnglish ? holidayMessageEnglish : holidayMessage}}</view></view>
    <view class="sample-card"><view class="sample-title">{{isEnglish ? 'Data & Reliability' : '数据与参考程度'}}</view><view class="sample-stats"><view><text class="sample-number">{{sample.observationCount}}</text><text>{{isEnglish ? ' records' : '条记录'}}</text></view><view><text class="sample-number">{{sample.dateCount}}</text><text>{{isEnglish ? ' dates' : '个出发日期'}}</text></view><view><text class="sample-number">{{sample.sourceCount}}</text><text>{{isEnglish ? ' sources' : '个公开来源'}}</text></view></view><view class="sample-meta">{{sample.recordBreakdown}}</view><view class="sample-meta">{{isEnglish ? 'Sources: ' : '来源：'}}{{sourceNames}}</view><view class="sample-meta">{{isEnglish ? 'Source freshness: ' : '来源页面时效：'}}{{isEnglish ? sample.sourceFreshnessEnglish : sample.sourceFreshnessNote}}</view><view class="sample-meta">{{isEnglish ? 'Collected: ' : '采集日期：'}}{{sample.collectionDate}} · {{isEnglish ? 'Reliability: ' : '参考程度：'}}{{sample.referenceLevel}}</view><view class="sample-meta">{{isEnglish ? sample.fxDescriptionEnglish : sample.fxDescription}}</view><view class="sample-meta">{{sample.cloudMergeNote}}</view><view class="sample-reason">{{isEnglish ? sample.reasonEnglish : sample.reason}}</view></view>
    <view class="footer">{{isEnglish ? 'Prices are shown in the selected currency. Listings may use other currencies; see data notes for exchange rates and collection dates. Fares change. For travel planning only.' : '页面价格按所选币种展示，来源标价可能使用其他币种；换算参考汇率与采集日见数据说明。价格会变化，分析仅作旅行决策参考。'}}</view>
  </block>
</view>
