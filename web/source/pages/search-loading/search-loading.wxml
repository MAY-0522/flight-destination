<view class="page">

<view class="loading-container">

  <!-- 图标 -->
  <view class="loading-icon">
    <view class="loading-circle">
      <view class="loading-plane">✈</view>
    </view>
  </view>

  <!-- 标题 -->
  <view class="title">
    正在寻找你的下一站
  </view>

  <!-- 当前状态 -->
  <view class="status-text">
    {{currentStep}}
  </view>

  <!-- 进度条 -->
  <view class="progress-wrapper">

    <view class="progress-background">
      <view
        class="progress-bar progress-{{progress}}"
      ></view>
    </view>

    <view class="progress-info">
      <text>探索进度</text>
      <text>{{progress}}%</text>
    </view>

  </view>

  <!-- 搜索过程提示 -->
  <view class="search-info">

    <view
      class="info-item"
      wx:if="{{progress >= 20}}"
    >
      <view class="check">✓</view>
      <text>分析旅行条件</text>
    </view>

    <view
      class="info-item"
      wx:if="{{progress >= 45}}"
    >
      <view class="check">✓</view>
      <text>搜索直飞航线</text>
    </view>

    <view
      class="info-item"
      wx:if="{{progress >= 70}}"
    >
      <view class="check">✓</view>
      <text>比较机票价格</text>
    </view>

    <view
      class="info-item"
      wx:if="{{progress >= 90}}"
    >
      <view class="check">✓</view>
      <text>筛选最佳目的地</text>
    </view>

  </view>

  <!-- 取消 -->
  <view
    class="cancel-button"
    wx:if="{{canCancel}}"
    bindtap="cancelSearch"
  >
    取消搜索
  </view>

</view>

</view>