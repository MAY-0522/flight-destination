page { background: #f5f8f7; color: #172020; font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif; }
view, text { box-sizing: border-box; }
.page { min-height: 100vh; background: #f5f8f7; padding-bottom: 60rpx; }
.top-bar { display:flex; align-items:center; justify-content:space-between; padding: 42rpx 36rpx 12rpx; }
.top-controls { display:flex; align-items:center; gap:8rpx; flex-shrink:0; }
.currency-switch { min-width:112rpx; padding:13rpx 17rpx; display:flex; align-items:center; justify-content:center; gap:9rpx; border-radius:999rpx; color:#117f80; background:#fff; box-shadow:0 2rpx 8rpx rgba(20,55,55,.08); font-size:21rpx; line-height:1.2; font-weight:700; white-space:nowrap; }
.currency-icon { min-width:24rpx; color:#159fa0; text-align:center; font-size:23rpx; line-height:1.2; font-weight:800; flex-shrink:0; }
.currency-arrow { width:0; height:0; margin-left:2rpx; border-left:7rpx solid transparent; border-right:7rpx solid transparent; border-top:9rpx solid #159fa0; transform:translateY(-2rpx); flex-shrink:0; }
.language-switch { display:flex; align-items:center; gap:4rpx; padding:5rpx; border-radius:999rpx; background:#e9eeee; }
.language-option { min-width:84rpx; padding:11rpx 16rpx; border-radius:999rpx; color:#7d8989; text-align:center; font-size:20rpx; line-height:1.2; font-weight:600; }
.language-option-active { color:#117f80; background:#fff; box-shadow:0 2rpx 8rpx rgba(20,55,55,.1); }
.brand { display: flex; align-items: center; min-height: 52rpx; }
.brand-icon { width: 72rpx; height: 72rpx; flex-shrink: 0; margin-right: 14rpx; overflow: hidden; border-radius: 50%; }

.brand-name { color: #182222; font-size: 31rpx; line-height: 52rpx; font-weight: 750; }
.hero { padding: 42rpx 36rpx 30rpx; }
.eyebrow { color: #159fa0; font-size: 25rpx; line-height: 1.4; font-weight: 700; }
.route-title { margin-top: 12rpx; color: #172020; font-size: 49rpx; line-height: 1.18; font-weight: 800; letter-spacing: -1.5rpx; }
.route-subtitle { margin-top: 12rpx; color: #788585; font-size: 25rpx; line-height: 1.55; }
.status-pill { display: inline-flex; margin-top: 18rpx; padding: 8rpx 16rpx; border-radius: 999rpx; color: #117f80; background: #e2f4f3; font-size: 20rpx; }
.notice-card { margin: 0 24rpx; padding: 24rpx 26rpx; border: 1rpx solid #dceeee; border-radius: 24rpx; background: #edf7f6; }
.notice-title { color: #253131; font-size: 25rpx; font-weight: 700; }
.notice-copy { margin-top: 9rpx; color: #788585; font-size: 22rpx; line-height: 1.6; }
.section-heading { margin: 34rpx 36rpx 16rpx; color: #253131; font-size: 26rpx; line-height: 36rpx; font-weight: 700; }
.section-heading text { margin-left: 8rpx; color: #9ca6a6; font-size: 19rpx; line-height: 1.4; font-weight: 400; }
.card, .sample-card { margin: 0 24rpx; padding: 30rpx 28rpx; border-radius: 28rpx; background: #fff; box-shadow: 0 12rpx 40rpx rgba(31,57,57,.07); }
.median-label { color: #788585; font-size: 22rpx; }
.median-price { margin-top: 8rpx; color: #159fa0; font-size: 48rpx; line-height: 1.25; font-weight: 750; }
.range-line { margin-top: 8rpx; color: #788585; font-size: 21rpx; }
.range-line text { padding: 0 10rpx; color: #aeb6b6; }
.quantile-grid { display: flex; justify-content: space-between; margin-top: 26rpx; padding-top: 22rpx; border-top: 1rpx solid #e4ebea; }
.quantile-item { display: flex; flex-direction: column; gap: 8rpx; color: #9ca6a6; font-size: 18rpx; }
.quantile-item text:last-child { color: #273333; font-size: 20rpx; font-weight: 600; }
.quantile-item.featured text { color: #159fa0; font-weight: 700; }
.hint { margin-top: 19rpx; color: #9ca6a6; font-size: 19rpx; line-height: 1.55; }
.chart-frame { position: relative; height: 260rpx; width: 100%; }
.chart-y-labels { position: absolute; left: 0; top: 0; width: 56rpx; height: 210rpx; }
.chart-y-label { position: absolute; right: 7rpx; width: 48rpx; transform: translateY(-50%); color: #9ca6a6; font-size: 17rpx; text-align: right; }
.chart-plot { position: absolute; left: 62rpx; top: 0; width: 520rpx; height: 255rpx; overflow: visible; }
.chart-gridline { position: absolute; left: 0; width: 520rpx; height: 1rpx; border-top: 1rpx solid #e4ebea; }
.chart-segment { position: absolute; height: 4rpx; border-radius: 99rpx; background: #159fa0; transform-origin: 0 50%; }
.chart-point { position: absolute; width: 14rpx; height: 14rpx; border: 3rpx solid #159fa0; border-radius: 50%; background: #fff; }
.chart-point-active { background: #159fa0; box-shadow: 0 0 0 6rpx #e2f4f3; }
.chart-point-label { position: absolute; width: 70rpx; color: #788585; font-size: 16rpx; line-height: 22rpx; font-weight: 600; text-align: center; }
.chart-point-low { color: #159fa0; font-weight: 700; }
.chart-day-label, .chart-day-count { position: absolute; width: 60rpx; text-align: center; white-space: nowrap; }
.chart-day-label { color: #53645c; font-size: 19rpx; }
.chart-day-count { color: #aeb6b6; font-size: 16rpx; }
.insight-note { margin-top: 20rpx; padding: 18rpx 19rpx; border-radius: 14rpx; color: #788585; background: #f5f8f7; font-size: 20rpx; line-height: 1.6; }
.compare-headline { color: #159091; font-size: 26rpx; font-weight: 700; }
.compare-values { display: flex; gap: 18rpx; margin-top: 22rpx; }
.compare-values > view { display: flex; flex: 1; flex-direction: column; gap: 8rpx; padding: 18rpx; border-radius: 16rpx; background: #f5f8f7; color: #9ca6a6; font-size: 19rpx; }
.compare-price { color: #273333; font-size: 25rpx; font-weight: 700; }
.lead-row + .lead-row { margin-top: 21rpx; }
.lead-top { display: flex; justify-content: space-between; margin-bottom: 9rpx; color: #788585; font-size: 21rpx; }
.lead-count { color: #9ca6a6; font-size: 18rpx; }
.lead-range { display: inline-block; }
.lead-range-highlight { padding: 1rpx 8rpx; border-radius: 8rpx; color: #137f7e; background: #e3f5f3; font-size: 23rpx; font-weight: 700; }
.lead-highlight { display: inline; color: #137f7e; font-size: 25rpx; font-weight: 700; }
.bar-track { flex: 1; height: 12rpx; overflow: hidden; border-radius: 99rpx; background: #edf7f6; }
.bar-fill { height: 100%; border-radius: inherit; background: #77c9c5; }
.lead-track { height: 10rpx; }
.lead-fill { background: #77c9c5; }
.holiday-card { display: flex; align-items: flex-start; gap: 15rpx; color: #788585; font-size: 22rpx; line-height: 1.6; }
.holiday-icon { display: flex; flex: none; align-items: center; justify-content: center; width: 34rpx; height: 34rpx; border-radius: 50%; color: #159fa0; background: #e2f4f3; font-size: 21rpx; font-weight: 700; }
.sample-card { margin-top: 34rpx; }
.sample-title { color: #253131; font-size: 26rpx; font-weight: 700; }
.sample-stats { display: flex; justify-content: space-between; margin: 24rpx 0 20rpx; }
.sample-stats > view { display: flex; flex-direction: column; gap: 6rpx; color: #9ca6a6; font-size: 18rpx; }
.sample-number { color: #159fa0; font-size: 31rpx; font-weight: 700; }
.sample-meta { margin-top: 8rpx; color: #788585; font-size: 19rpx; line-height: 1.5; }
.sample-reason { margin-top: 18rpx; padding-top: 17rpx; border-top: 1rpx solid #e4ebea; color: #788585; font-size: 19rpx; line-height: 1.55; }
.unavailable-card { padding-top: 28rpx; padding-bottom: 28rpx; }
.footer { padding: 24rpx 30rpx 8rpx; color: #9ca6a6; text-align: center; font-size: 18rpx; line-height: 1.6; }
.chart-canvas { display: block; margin: 0 auto; }
.chart-summary { display: flex; justify-content: space-between; margin: 0 0 6rpx; }
.chart-summary-item { display: flex; width: 14%; flex-direction: column; align-items: center; gap: 4rpx; color: #788585; font-size: 16rpx; }
.chart-summary-item text:nth-child(2) { color: #159fa0; font-size: 17rpx; font-weight: 700; }
.chart-summary-item text:nth-child(3) { color: #aeb6b6; font-size: 14rpx; }

.weekday-chart-card { overflow: hidden; padding-left: 20rpx; padding-right: 20rpx; }
.chart-caption { display: flex; align-items: center; gap: 10rpx; padding-left: 12rpx; color: #788585; font-size: 19rpx; }
.chart-legend-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #159fa0; }
.chart-stage { position: relative; width: 610rpx; height: 320rpx; margin: 8rpx auto 0; }
.chart-canvas { display: block; width: 610rpx; height: 320rpx; }
.chart-tooltip { position: absolute; z-index: 2; display: flex; gap: 8rpx; align-items: center; padding: 8rpx 12rpx; border: 1rpx solid #b9e5df; border-radius: 12rpx; color: #287e79; background: rgba(255,255,255,.97); box-shadow: 0 5rpx 18rpx rgba(31,87,83,.15); font-size: 18rpx; line-height: 1.2; white-space: nowrap; pointer-events: none; }
.chart-tooltip text:last-child { color: #177f7e; font-weight: 700; }
.weekday-extremes { display: flex; gap: 12rpx; margin: 2rpx 8rpx 0; }
.weekday-extreme { display: flex; flex: 1; flex-direction: column; gap: 8rpx; min-width: 0; padding: 16rpx 14rpx; border-radius: 16rpx; background: #f5f8f7; }
.weekday-extreme text:first-child { color: #9ca6a6; font-size: 18rpx; }
.weekday-extreme text:last-child { color: #273333; font-size: 20rpx; font-weight: 700; white-space: nowrap; }
.weekday-extreme.low text:last-child { color: #159fa0; }

.weekday-days { display: flex; justify-content: space-between; margin: -2rpx 4rpx 12rpx; }
.weekday-day { width: 14%; color: #53645c; font-size: 18rpx; text-align: center; }

.chart-legend-dot.low { background: #159fa0; }
.chart-legend-dot.high { background: #f0a24a; }
.weekday-day.low { color: #159fa0; font-weight: 700; }
.weekday-day.high { color: #d7852d; font-weight: 700; }


.unavailable-card { display: flex; flex-direction: column; gap: 16rpx; margin: 32rpx 24rpx; padding: 30rpx; border-radius: 26rpx; background: #fff; box-shadow: 0 12rpx 40rpx rgba(31,57,57,.07); }
.unavailable-icon { display: flex; align-items: center; justify-content: center; width: 42rpx; height: 42rpx; border-radius: 50%; color: #159fa0; background: #e2f4f3; font-size: 24rpx; font-weight: 700; }
.unavailable-title { color: #253131; font-size: 27rpx; font-weight: 700; }
.unavailable-copy { color: #788585; font-size: 22rpx; line-height: 1.65; }







